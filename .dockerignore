# 手元のDBのデータ（容量が大きく、手元専用）
docker/mysql/data

# 手元でインストールしたもの（イメージの中で入れ直す）
src/vendor
src/node_modules

# 手元専用の設定（パスワードなどが入っている）
src/.env

# 手元の開発サーバー用の目印とビルド結果
src/public/hot
src/public/build

# 手元で作られたキャッシュとログ
src/bootstrap/cache/*.php
src/storage/logs/*
src/storage/framework/cache/*
src/storage/framework/sessions/*
src/storage/framework/views/*
src/.phpunit.result.cache

# 手元のストレージの近道と、手元で試しに出品・登録した画像（デモの画像はDockerfileで入れる）
src/public/storage
src/storage/app/public/*

# テストのときだけ使う仮の保存場所
src/storage/framework/testing

.git
