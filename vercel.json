{
  "version": 2,
  "framework": null,
  "functions": {
    "api/index.php": {
      "runtime": "@juicyfx/vercel-php@3.0.0"
    }
  },
  "routes": [
    {
      "src": "/_vercel/insights(.*)",
      "dest": "/_vercel/insights$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
