{
  "version": 2,
  "framework": null,
  "functions": {
    "src/api/index.php": {
      "runtime": "vercel-php@0.7.6"
    }
  },
  "routes": [
    {
      "src": "/_vercel/insights(.*)",
      "dest": "/_vercel/insights$1"
    },
    {
      "src": "/(.*)",
      "dest": "/src/api/index.php"
    }
  ]
}
